# Configurações do MySQL (Service Order)
MYSQL_SO_PORT=3307
MYSQL_SO_DB=oficina_db
MYSQL_SO_USER=oficina_user
MYSQL_SO_PASSWORD=oficina_pass
DB_HOST=mysql-service-order
DB_PORT=3306
DB_NAME=oficina_db
DB_USERNAME=oficina_user
DB_PASSWORD=oficina_pass
MYSQL_ROOT_PASSWORD=root_password

# Configurações do MySQL (Payment Billing)
MYSQL_PAY_PORT=3308
MYSQL_PAY_DB=payment_db
MYSQL_PAY_USER=oficina_user
MYSQL_PAY_PASSWORD=oficina_pass

# Configurações do MongoDB (Notification Audit)

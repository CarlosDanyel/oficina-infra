# Configurações do MySQL (Service Order)
MYSQL_SO_PORT=3307
MYSQL_SO_DB=oficina_db
MYSQL_SO_USER=oficina_user
MYSQL_SO_PASSWORD=oficina_pass

# Configurações do MySQL (Payment Billing)
MYSQL_PAY_PORT=3308
MYSQL_PAY_DB=payment_db
MYSQL_PAY_USER=oficina_user
MYSQL_PAY_PASSWORD=oficina_pass

# Configurações do MongoDB (Notification Audit)
MONGO_PORT=27017
MONGO_DB=notification_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root_password

# Configurações do RabbitMQ Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

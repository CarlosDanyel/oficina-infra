{
  "info": {
    "name": "FIAP Oficina — Fluxo Completo de Ordens de Serviço e Microsserviços",
    "description": "Postman Collection completa contendo Happy Path (Sucesso) e Saga Rollback (Falha + Compensação) para testes de validação dos microsserviços.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url_so", "value": "http://localhost:8080" },
    { "key": "base_url_pay", "value": "http://localhost:8081" },
    { "key": "base_url_notif", "value": "http://localhost:8082" },
    { "key": "rabbitmq_ui", "value": "http://localhost:15672" },
    { "key": "os_id", "value": "" },
    { "key": "approval_token", "value": "" },
    { "key": "external_payment_id", "value": "" },
    { "key": "os_id_rollback", "value": "" },
    { "key": "approval_token_rollback", "value": "" },
    { "key": "external_payment_id_rollback", "value": "" }
  ],
  "item": [
    {
      "name": "🏁 1. HAPPY PATH — Fluxo Completo de Sucesso (OS -> PIX Aprovado -> DELIVERED)",
      "description": "Execute os endpoints sequencialmente nesta pasta para vivenciar o ciclo de vida completo de uma OS finalizada e entregue com sucesso.",
      "item": [
        {
          "name": "Passo 1.1: Criar Ordem de Serviço (POST /api/service-orders)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.collectionVariables.set('os_id', data.id);",
                "pm.test('Status 201 Created', function() { pm.response.to.have.status(201); });",
                "pm.test('Status RECEIVED', function() { pm.expect(data.status).to.equal('RECEIVED'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Carlos Danyel\",\n    \"email\": \"carlos@test.com\",\n    \"phone\": \"11999998888\"\n  },\n  \"vehicle\": {\n    \"licensePlate\": \"ABC-1234\",\n    \"brand\": \"Honda\",\n    \"model\": \"Civic\",\n    \"year\": 2024,\n    \"color\": \"Preto\"\n  },\n  \"services\": [],\n  \"parts\": [],\n  \"notes\": \"Barulho leve ao frear\"\n}"
            },
            "url": {
              "raw": "{{base_url_so}}/api/service-orders",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders"]
            }
          }
        },
        {
          "name": "Passo 1.2: Atualizar Status para DIAGNOSTICO (PATCH /api/service-orders/{id}/status)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.test('Status DIAGNOSIS', function() { pm.expect(data.status).to.equal('DIAGNOSIS'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"DIAGNOSIS\",\n  \"services\": [\n    {\n      \"name\": \"Troca de Óleo e Filtro\",\n      \"description\": \"Substituição do óleo do motor e filtro\",\n      \"price\": 250.00,\n      \"estimatedHours\": 1.5\n    }\n  ],\n  \"parts\": [\n    {\n      \"name\": \"Filtro de Óleo\",\n      \"partNumber\": \"FO-9988\",\n      \"quantity\": 1,\n      \"unitPrice\": 50.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url_so}}/api/service-orders/{{os_id}}/status",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders", "{{os_id}}", "status"]
            }
          }
        },
        {
          "name": "Passo 1.3: Gerar Orçamento → AGUARDANDO APROVACAO (PATCH /api/service-orders/{id}/status)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "if (data.approvalToken) { pm.collectionVariables.set('approval_token', data.approvalToken); }",
                "pm.test('Status AWAITING_APPROVAL', function() { pm.expect(data.status).to.equal('AWAITING_APPROVAL'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"AWAITING_APPROVAL\"\n}"
            },
            "url": {
              "raw": "{{base_url_so}}/api/service-orders/{{os_id}}/status",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders", "{{os_id}}", "status"]
            }
          }
        },
        {
          "name": "Passo 1.4: Cliente Aprova Orçamento (GET /api/quotations/{id})",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.test('Status EXECUTION', function() { pm.expect(data.status).to.equal('EXECUTION'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_so}}/api/quotations/{{os_id}}?token={{approval_token}}&approved=true",
              "host": ["{{base_url_so}}"],
              "path": ["api", "quotations", "{{os_id}}"],
              "query": [
                { "key": "token", "value": "{{approval_token}}" },
                { "key": "approved", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Passo 1.5: Concluir Serviço → FINALIZADO (PATCH /api/service-orders/{id}/status)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.test('Status FINISHED', function() { pm.expect(data.status).to.equal('FINISHED'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"FINISHED\"\n}"
            },
            "url": {
              "raw": "{{base_url_so}}/api/service-orders/{{os_id}}/status",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders", "{{os_id}}", "status"]
            }
          }
        },
        {
          "name": "Passo 1.6: Criar Pagamento PIX (POST /api/payments)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.collectionVariables.set('external_payment_id', data.externalId);",
                "pm.test('Payment Created (PENDING)', function() { pm.expect(data.status).to.equal('PENDING'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceOrderId\": \"{{os_id}}\",\n  \"amount\": 300.00,\n  \"customerEmail\": \"carlos@test.com\"\n}"
            },
            "url": {
              "raw": "{{base_url_pay}}/api/payments",
              "host": ["{{base_url_pay}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Passo 1.7: Webhook Pagamento Aprovado (POST /api/payments/webhook)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Webhook Processed 200 OK', function() { pm.response.to.have.status(200); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url_pay}}/api/payments/webhook?data.id={{external_payment_id}}&action=payment.updated",
              "host": ["{{base_url_pay}}"],
              "path": ["api", "payments", "webhook"],
              "query": [
                { "key": "data.id", "value": "{{external_payment_id}}" },
                { "key": "action", "value": "payment.updated" }
              ]
            }
          }
        },
        {
          "name": "Passo 1.8: Consultar OS Final (DELIVERED) (GET /api/service-orders/{id}/status)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var data = pm.response.json();",
                "pm.test('Status DELIVERED (Entregue)', function() { pm.expect(data.status).to.equal('DELIVERED'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_so}}/api/service-orders/{{os_id}}/status",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders", "{{os_id}}", "status"]
            }
          }
        }
      ]
    },
    {

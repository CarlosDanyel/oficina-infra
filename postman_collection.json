    {
      "name": "🛠️ 3. ENDPOINTS POR MICROSSERVIÇO",
      "description": "Endpoints individuais de cada serviço para consultas e testes pontuais.",
      "item": [
        {
          "name": "Service Order — Listar todas as OS (GET /api/service-orders)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_so}}/api/service-orders",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders"]
            }
          }
        },
        {
          "name": "Service Order — Consultar OS por ID (GET /api/service-orders/{id}/status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_so}}/api/service-orders/{{os_id}}/status",
              "host": ["{{base_url_so}}"],
              "path": ["api", "service-orders", "{{os_id}}", "status"]
            }
          }
        },
        {
          "name": "Payment Billing — Consultar Pagamento por OS (GET /api/payments/service-order/{os_id})",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_pay}}/api/payments/service-order/{{os_id}}",
              "host": ["{{base_url_pay}}"],
              "path": ["api", "payments", "service-order", "{{os_id}}"]
            }
          }
        },
        {
          "name": "Notification Service — Actuator Health (GET /actuator/health)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url_notif}}/actuator/health",
              "host": ["{{base_url_notif}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
